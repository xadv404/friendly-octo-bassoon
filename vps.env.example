# Copier vers vps.env (gitignored) — accès SSH VPS pour agents / déploiement
#
# Usage:
#   cp vps.env.example vps.env
#   chmod 600 vps.env
#   ./scripts/vps-ssh.sh              # shell interactif
#   ./scripts/vps-run.sh 'ls -la'     # commande distante
#   ./scripts/vps-sync.sh             # sync binaires + env sur le VPS

# --- Connexion ---
VPS_HOST=your.vps.ip.or.hostname
VPS_USER=root
VPS_PORT=22
VPS_PATH=/opt/sqli-hunter

# Clé privée (recommandé). Chemin absolu ou ~/
SSH_KEY_PATH=~/.ssh/id_ed25519

# Optionnel : passphrase clé (éviter en prod — préférer ssh-agent)
# SSH_KEY_PASSPHRASE=

# Optionnel : bastion / jump host
# VPS_JUMP_HOST=bastion.example.com
# VPS_JUMP_USER=jumpuser

# Options SSH extra (une ligne)
# SSH_OPTIONS=-o StrictHostKeyChecking=accept-new

# Timeout connexion (secondes)
SSH_CONNECT_TIMEOUT=15
