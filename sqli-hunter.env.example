# Copier vers sqli-hunter.env (gitignored)
# Proxy BP résidentiel — IP rotative à chaque requête (pas de rotation côté code)
DISCOVER_PROXY=http://user:pass:residential.bpproxy.at:1000

# Google = scraping direct (TLS Chrome + Chromium headless). Pas de SerpAPI requis.
# Optionnel — legacy SerpAPI (non utilisé par défaut)
# SERPAPI_API_KEY=your_serpapi_key
