# Copier vers tg-bot.env et remplir (fichier gitignored)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Ton ID Telegram (envoie /myid au bot une fois lancé)
# Utilisé par tg-bot ET les alertes sqli-hunter (vulns, dumps, daily)
TELEGRAM_ALLOWED_IDS=123456789
# Langue des messages bot + alertes: fr (défaut) ou en
TELEGRAM_LOCALE=fr
RESULTS_DIR=results
TELEGRAM_MAX_EMAILS=10000
